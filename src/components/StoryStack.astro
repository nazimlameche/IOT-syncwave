---
/**
 * Récit en cartes — DESIGN.md §5 Récit et §4.
 * Les chapitres (StoryCard) défilent normalement ; chacun joue son moment animé en arrivant à l'écran.
 */
interface Props {
  id?: string;
  title: string;
  intro: string;
}
const { id, title, intro } = Astro.props;
import Fold from './Fold.astro';
---

<section id={id} class="story mx-auto max-w-content px-3 md:px-4" data-story>
  <div class="px-3 pb-12 md:px-8">
    <Fold as="h2" text={title} class="text-h1 text-text" />
    <Fold text={intro} class="mt-4 text-body-lg text-text-muted" />
  </div>

  <div class="story-deck mx-auto max-w-card">
    <slot />
  </div>
</section>

<script>
  /**
   * Récit : les cartes défilent normalement. Pour chaque carte, « progression » = 0 quand son haut entre
   * par le bas de l'écran, 1 quand il atteint ARRIVED_LINE.
   * La carte active (dernière à avoir dépassé ACTIVE_AT) reçoit .is-active et joue son moment animé ;
   * les précédentes reçoivent .is-past (état final). --story-explode (0 → 1, lissé) ouvre la vue éclatée.
   */
  const ARRIVED_LINE = 0.4; // en part de la hauteur de l'écran
  const ACTIVE_AT = 0.75; // la carte devient active quand son haut atteint ≈ 55 % de l'écran
  const EXPLODE_FROM = 0.25;

  function initStory() {
    const root = document.querySelector<HTMLElement>('[data-story]');
    if (!root) return;
    const slots = [...root.querySelectorAll<HTMLElement>('[data-story-slot]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    const update = () => {
      frame = 0;
      const vh = window.innerHeight;
      const progress = slots.map((slot) => {
        const top = slot.getBoundingClientRect().top;
        return Math.min(1, Math.max(0, (vh - top) / (vh * (1 - ARRIVED_LINE))));
      });
      let active = -1;
      progress.forEach((p, i) => {
        if (p >= ACTIVE_AT) active = i;
      });
      slots.forEach((slot, i) => {
        const t = Math.min(1, Math.max(0, (progress[i] - EXPLODE_FROM) / (1 - EXPLODE_FROM)));
        const explode = reducedMotion.matches ? 1 : t * t * (3 - 2 * t);
        slot.style.setProperty('--story-explode', explode.toFixed(3));
        slot.classList.toggle('is-active', i === active);
        slot.classList.toggle('is-past', i < active);
      });
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
    // Les états « avant animation » ne s'appliquent qu'une fois le script prêt : sans JS, tout est visible.
    root.setAttribute('data-ready', '');
  }

  initStory();
</script>
