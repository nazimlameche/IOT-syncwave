---
/**
 * Séquence "Comment ça marche" — DESIGN.md §5.
 * Seul endroit où la numérotation est autorisée. Trois étapes maximum.
 */
interface Step {
  title: string;
  text: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<ol class="grid gap-6 md:grid-cols-3 md:gap-8">
  {
    steps.slice(0, 3).map((s, i) => (
      <li class="border-t border-line pt-6">
        <span class="font-display text-h2 font-semibold text-text-muted" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-4 text-h2 text-text">{s.title}</h3>
        <p class="mt-3 text-body text-text-muted">{s.text}</p>
      </li>
    ))
  }
</ol>
