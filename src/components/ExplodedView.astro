---
/**
 * Vue éclatée — DESIGN.md §5.
 * Image fixe des composants séparés verticalement, légendes numérotées de haut en bas
 * (vraie séquence : l'ordre d'assemblage). Sur desktop les légendes sont posées sur l'image
 * à la hauteur du composant ; sur mobile elles passent en liste sous l'image.
 */
interface Label {
  title: string;
  text: string;
  /** Position verticale du composant sur l'image, en % de la hauteur. */
  y: number;
}
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  labels: Label[];
}
const { src, alt, width, height, labels } = Astro.props;
---

<div class="grid items-center gap-6 md:grid-cols-2 md:gap-8">
  <div class="relative mx-auto w-full max-w-sm md:max-w-md">
    <img
      src={src}
      width={width}
      height={height}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="mask-fade w-full"
    />
    <!-- Repères : un point sur le composant, à la hauteur indiquée -->
    <ol class="pointer-events-none absolute inset-0 hidden md:block" aria-hidden="true">
      {
        labels.map((l, i) => (
          <li class="absolute right-0 flex w-1/3 items-center gap-3" style={`top: ${l.y}%`}>
            <span class="h-px flex-1 bg-line" />
            <span class="font-display text-small font-semibold text-text-muted">{String(i + 1).padStart(2, '0')}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <ol class="grid gap-6">
    {
      labels.map((l, i) => (
        <li class="flex gap-4 border-t border-line pt-4">
          <span class="font-display text-h2 font-semibold text-text-muted">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-h2 text-text">{l.title}</h3>
            <p class="mt-2 text-body text-text-muted">{l.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>
