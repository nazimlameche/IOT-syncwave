---
/**
 * Carte de specs — DESIGN.md §5.
 * `highlight` : le chiffre le plus important du site, en cyan. Un seul sur toute la page.
 */
interface Props {
  value: string;
  label: string;
  highlight?: boolean;
}
const { value, label, highlight = false } = Astro.props;
---

<div class="rounded-lg border border-line bg-surface p-8">
  <p class={`font-display text-kpi ${highlight ? 'text-cyan' : 'text-text'}`}>{value}</p>
  <p class="mt-3 text-small text-text-muted">{label}</p>
</div>
