---
/**
 * Ligne de spec — DESIGN.md §5 Carte de specs. Valeur à gauche, libellé à droite.
 * `highlight` : le chiffre le plus important du site, en cyan et en grand. Un seul sur la page.
 */
interface Props {
  value: string;
  label: string;
  highlight?: boolean;
}
const { value, label, highlight = false } = Astro.props;
---

<div class="flex items-center gap-4 rounded-lg border border-line bg-surface-2 px-4 py-3">
  <p class={`shrink-0 whitespace-nowrap font-display font-bold ${highlight ? 'text-h1 text-cyan' : 'w-16 text-h2 text-text'}`}>{value}</p>
  <p class="text-small text-text-muted">{label}</p>
</div>
