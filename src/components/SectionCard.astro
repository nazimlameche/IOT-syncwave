---
import Fold from './Fold.astro';
import StarBorder from './react/StarBorder.jsx';
import { EFFECTS } from './react/effects.js';

/**
 * Carte de section compacte — DESIGN.md §5.
 * Bordure animée StarBorder (composant React rendu côté serveur uniquement : aucun JS envoyé).
 * Gauche : titre qui se déplie, description dessous (slot par défaut).
 * Droite (slot "aside", facultatif) : visuel (MediaCard) ou contenu (liste, specs, formulaire).
 */
interface Props {
  id?: string;
  title: string;
  titleTag?: 'h2' | 'h3';
}
const { id, title, titleTag = 'h2' } = Astro.props;
const hasAside = Astro.slots.has('aside');
const { colorToken, speed, thickness } = EFFECTS.cardBorder;
---

<StarBorder
  as="section"
  id={id}
  className="section-card"
  color={`var(${colorToken})`}
  speed={speed}
  thickness={thickness}
  backgroundColor="var(--color-surface)"
  textColor="var(--color-text)"
  borderColor="var(--color-line)"
>
  <div class={`grid items-center gap-6 p-6 md:gap-8 md:p-8 ${hasAside ? 'md:grid-cols-5' : ''}`}>
    <div class={hasAside ? 'md:col-span-3' : ''}>
      <Fold as={titleTag} text={title} class="text-h2 text-text" />
      <div class="mt-4 grid gap-4">
        <slot />
      </div>
    </div>
    {hasAside && <div class="md:col-span-2"><slot name="aside" /></div>}
  </div>
</StarBorder>
