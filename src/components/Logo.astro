---
/**
 * Logo Syncwave : pictogramme "S" (fourni, bicolore, seule exception à la règle
 * « une couleur néon par section », voir DESIGN.md §2) + wordmark en Sora.
 */
interface Props {
  class?: string;
}
const { class: extra = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2 font-display font-bold text-h2 text-text ${extra}`}>
  <img
    src="/brand/syncwave-mark-512.png"
    width="512"
    height="512"
    alt=""
    aria-hidden="true"
    decoding="async"
    class="size-10"
  />
  <span>Syncwave</span>
</span>
