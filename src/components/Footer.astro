---
import Button from './Button.astro';
import FooterRing from './react/FooterRing.jsx';
import SyncwaveWordmark from './react/SyncwaveWordmark.jsx';

/**
 * Bas de page — DESIGN.md §5 Pied de page. Pas une carte : deux bandeaux pleine largeur.
 * 1. Bandeau d'appel : titre à gauche, boutons au centre, trois points clés à droite.
 * 2. Barre de pied de page : logo dans son anneau de texte + « Syncwave » qui se dessine, trait,
 *    signature, liens ; puis une ligne de mentions.
 */
const links = [
  { href: '/#fonctionnalites', label: 'Fonctionnalités' },
  { href: '/#comment-ca-marche', label: 'Comment ça marche' },
  { href: '/#caracteristiques', label: 'Caractéristiques' },
  { href: '/#a-propos', label: 'Équipe' },
  { href: '/presse', label: 'Presse' },
];
const points = ['Lumière synchronisée', 'Paiement et accès', 'Amis et SOS'];
const year = new Date().getFullYear();
---

<footer class="bg-bg">
  <section aria-labelledby="cta-titre" class="border-t border-line">
    <div class="flex flex-col gap-8 px-6 py-12 md:px-12 lg:flex-row lg:items-center lg:justify-between">
      <h2 id="cta-titre" class="max-w-lg font-display text-h1 uppercase text-text">Faisons vibrer votre prochain festival.</h2>
      <div class="flex flex-wrap items-center gap-4">
        <Button href="/#demo">Demander une démo</Button>
        <Button href="/#fonctionnalites" variant="secondary">En savoir plus</Button>
      </div>
      <ul class="grid gap-3 text-body text-text">
        {
          points.map((p) => (
            <li class="flex items-center gap-3">
              <svg viewBox="0 0 24 24" fill="none" class="size-5 stroke-cyan" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m8 12.5 2.5 2.5L16 9.5" />
              </svg>
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div>
    <div class="px-6 md:px-12">
      <div class="flex flex-wrap items-center gap-x-8 gap-y-6 py-8">
        <a href="/" class="flex items-center gap-4" aria-label="Syncwave, accueil">
          <span class="footer-logo relative flex items-center justify-center" aria-hidden="true">
            <FooterRing client:only="react" />
            <img src="/brand/syncwave-mark-512.png" width="512" height="512" alt="" class="absolute size-12" loading="lazy" decoding="async" />
          </span>
          <span class="footer-wordmark" aria-hidden="true">
            <SyncwaveWordmark client:only="react" />
            <noscript><span class="font-display text-h2 font-bold text-text">Syncwave</span></noscript>
          </span>
        </a>
        <span class="hidden h-px min-w-12 flex-1 bg-line lg:block" aria-hidden="true"></span>
        <p class="text-small font-semibold uppercase tracking-widest text-text">Le bracelet des festivals</p>
        <nav aria-label="Liens de bas de page" class="flex flex-wrap gap-6 text-small font-medium">
          {
            links.map((l) => (
              <a href={l.href} class="text-text decoration-1 decoration-cyan underline-offset-4 hover:underline">
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex flex-wrap justify-between gap-4 border-t border-line py-6 text-small text-text-muted">
        <p>Syncwave réunit lumière, paiement, accès et sécurité dans un seul bracelet.</p>
        <p>
          <!-- TODO: remplacer « Mooroon 5 » par /brand/mooroon5-mono.svg (blason monochrome) quand l'asset existe, voir DESIGN.md §2 -->
          <!-- TODO: mentions légales (éditeur, hébergeur, données du formulaire) -->
          Un produit <span class="font-medium text-text">Mooroon 5</span> · © {year} projet étudiant EPITA · <a href="#" class="decoration-1 decoration-cyan underline-offset-4 hover:underline">Mentions légales</a>
        </p>
      </div>
    </div>
  </div>
</footer>
