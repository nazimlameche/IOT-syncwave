---
import Button from './Button.astro';

/**
 * Formulaire de demande de démo — DESIGN.md §5.
 * Netlify Forms via `data-netlify` ; sur Vercel, brancher `action` sur un endpoint (TODO).
 */
const field =
  'mt-2 w-full rounded-md border border-line bg-surface-2 px-4 py-3 text-body text-text placeholder:text-text-muted transition-colors duration-fast ease-out-token focus:border-cyan focus:outline-none';
---

<form
  name="demo"
  method="POST"
  action="/merci"
  data-netlify="true"
  netlify-honeypot="site-web"
  class="grid gap-6"
  novalidate
>
  <input type="hidden" name="form-name" value="demo" />
  <p class="hidden">
    <label>Ne pas remplir : <input name="site-web" /></label>
  </p>

  <div class="grid gap-6 md:grid-cols-2 md:gap-8">
    <div>
      <label for="nom" class="block text-small text-text-muted">Nom</label>
      <input id="nom" name="nom" type="text" autocomplete="name" required class={field} placeholder="Votre nom" />
    </div>
    <div>
      <label for="email" class="block text-small text-text-muted">Adresse e-mail</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class={field}
        placeholder="vous@festival.fr"
      />
    </div>
  </div>
  <div>
    <label for="message" class="block text-small text-text-muted">Votre événement</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class={field}
      placeholder="Nom de l'événement, dates, nombre de festivaliers attendus"></textarea>
  </div>

  <p id="form-status" class="text-body text-text-muted" aria-live="polite"></p>

  <div>
    <Button type="submit">Demander une démo</Button>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('form[name="demo"]');
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', (e) => {
    const email = form.querySelector<HTMLInputElement>('#email');
    const nom = form.querySelector<HTMLInputElement>('#nom');
    if (!status || !email || !nom) return;
    if (!nom.value.trim()) {
      e.preventDefault();
      status.textContent = 'Merci d’indiquer votre nom.';
      nom.focus();
    } else if (!email.checkValidity()) {
      e.preventDefault();
      status.textContent = 'Cette adresse e-mail ne semble pas valide.';
      email.focus();
    } else {
      status.textContent = 'Votre demande est en cours d’envoi.';
    }
  });
</script>
