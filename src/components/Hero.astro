---
import Button from './Button.astro';
import HeroWordmark from './react/HeroWordmark.jsx';

/**
 * Hero à fond animé — DESIGN.md §5 Hero (variante « Fond animé »), §4 et §4 bis.
 * « Syncwave » se dessine en boucle, entouré de son orbite d'icônes, sur le fond animé de la page.
 */
---

<!-- Fond transparent : le fond animé de la page (PageBackground, index.astro) passe dessous -->
<section id="hero" class="relative flex min-h-dvh items-center justify-center overflow-hidden">

  <div class="pointer-events-none relative mx-auto flex w-full max-w-content flex-col items-center px-6 py-24 text-center md:px-12">
    <h1 class="hero-title w-full text-text">
      <span class="sr-only">Syncwave, créons ensemble le festival de demain</span>
      <span class="flex flex-col items-center gap-4" aria-hidden="true">
        <span class="hero-wordmark block w-full">
          <HeroWordmark client:only="react" />
          <noscript><span class="block font-display text-display">Syncwave</span></noscript>
        </span>
        <span class="block text-h1">Créons ensemble le festival de demain</span>
      </span>
    </h1>
    <p class="mt-6 text-body-lg text-text">
      Syncwave réunit lumière, paiement, accès et sécurité dans un seul bracelet, et vous donne une vue
      d'ensemble de votre événement.
    </p>
    <div class="pointer-events-auto mt-8 flex flex-wrap items-center justify-center gap-6">
      <Button href="#demo">Demander une démo</Button>
      <Button href="#fonctionnalites" variant="link">Voir les fonctionnalités</Button>
    </div>
  </div>
</section>
