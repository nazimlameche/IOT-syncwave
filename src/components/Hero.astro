---
import Button from './Button.astro';

/**
 * Hero en bandeau photo — DESIGN.md §5 Hero (variante photo) et §4.
 * Seul moment animé du site : la photo apparaît, puis le halo cyan s'allume et respire.
 */
---

<section id="hero" class="relative flex min-h-dvh items-end overflow-hidden">
  <!-- Visuel généré par IA, voir DESIGN.md §8 -->
  <img
    class="hero-product absolute inset-0 h-full w-full object-cover"
    src="/product/ambiance-foule.webp"
    width="1600"
    height="900"
    alt="Foule de festival la nuit, poignets levés portant des bracelets Syncwave allumés en cyan"
    fetchpriority="high"
    decoding="async"
  />
  <!-- Halo : la lumière vient de la scène et des bracelets, il respire -->
  <div class="hero-halo pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/2 top-1/4 h-1/2 w-2/3 -translate-x-1/2 rounded-full bg-cyan/20 blur-halo"></div>
  </div>
  <div class="pointer-events-none absolute inset-0 bg-scrim" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-content px-6 pb-section pt-40 md:px-12">
    <div class="max-w-prose">
      <h1 class="text-display text-text">Tout le festival au poignet</h1>
      <p class="mt-6 text-body-lg text-text-muted">
        Syncwave réunit lumière, paiement, accès et sécurité dans un seul bracelet, et vous donne une vue
        d'ensemble de votre événement.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <Button href="#demo">Demander une démo</Button>
        <Button href="#fonctionnalites" variant="link">Voir les fonctionnalités</Button>
      </div>
    </div>
  </div>
</section>
