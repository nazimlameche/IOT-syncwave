---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SectionCard from '../components/SectionCard.astro';
import MediaCard from '../components/MediaCard.astro';
import Fold from '../components/Fold.astro';
import PageBackground from '../components/react/PageBackground.jsx';
import TeamCard from '../components/react/TeamCard.jsx';
import SpecCard from '../components/SpecCard.astro';
import DemoForm from '../components/DemoForm.astro';
import Footer from '../components/Footer.astro';
import StoryStack from '../components/StoryStack.astro';
import StoryCard from '../components/StoryCard.astro';
import Button from '../components/Button.astro';
import Points from '../components/Points.astro';
import ExplodedView from '../components/motion/ExplodedView.astro';
import PayMotion from '../components/motion/PayMotion.astro';
import CrowdMotion from '../components/motion/CrowdMotion.astro';
import SosMotion from '../components/motion/SosMotion.astro';

// Récit en cartes empilées — DESIGN.md §5 Récit. Une nuit de festival, du point de vue de l'organisateur.
// TODO: contenu à valider — textes écrits à partir des informations déjà présentes sur le site
// (fonctions, prix, composants). Aucune caractéristique technique chiffrée n'a été ajoutée.
const chapters = [
  { id: 'le-constat', time: 'Aujourd’hui', chapter: 'Le constat' },
  { id: 'sous-le-silicone', time: 'Et si…', chapter: 'L’idée' },
  { id: 'comment-ca-marche', time: 'J-30', chapter: 'La préparation' },
  { id: 'ouverture', time: '18:00', chapter: 'Ouverture des portes' },
  { id: 'bars', time: '21:00', chapter: 'Les bars se remplissent' },
  { id: 'tete-d-affiche', time: '23:00', chapter: 'La tête d’affiche' },
  { id: 'alerte', time: '01:00', chapter: 'Une alerte' },
  { id: 'regie', time: 'Toute la nuit', chapter: 'La régie' },
  { id: 'caracteristiques', time: 'Le lendemain', chapter: 'Le bilan' },
];
const ch = Object.fromEntries(chapters.map((c, i) => [c.id, { ...c, index: i }]));

// Pièces de la vue éclatée, de haut en bas (numérotées comme sur le visuel)
const parts = ['Bracelet silicone', 'Bande LED', 'Boîtier', 'Carte électronique et antenne NFC', 'Batterie'];

const providers = ['Billetterie', 'Paiement', 'Sécurité', 'Lumière', 'Données'];
const preparation = ['Chaque bracelet associé à un billet', 'Une plateforme pour toutes vos équipes', 'Un prix fixe par festivalier'];

// Bilan : uniquement des éléments déjà établis sur le site.
// TODO: contenu à valider — ajouter l'autonomie réelle (heures ou jours) et l'indice d'étanchéité (IP) quand ils sont connus.
const specs = [
  { value: '7 €', label: 'par festivalier, tout compris', highlight: true },
  { value: 'NFC', label: 'Paiement et contrôle d’accès sans contact' },
  { value: '0', label: 'écran ni bouton : rien à apprendre' },
  { value: '5', label: 'pièces, du bracelet silicone à la batterie' },
];

// Équipe Mooroon 5 — DESIGN.md §5 Équipe
// TODO: contenu à valider — noms, rôles et photos réels des membres (photo détourée, fond transparent)
const team = [
  { name: 'Membre 1', role: 'Rôle à préciser', handle: 'mooroon5', status: 'EPITA' },
  { name: 'Membre 2', role: 'Rôle à préciser', handle: 'mooroon5', status: 'EPITA' },
  { name: 'Membre 3', role: 'Rôle à préciser', handle: 'mooroon5', status: 'EPITA' },
  { name: 'Membre 4', role: 'Rôle à préciser', handle: 'mooroon5', status: 'EPITA' },
  { name: 'Membre 5', role: 'Rôle à préciser', handle: 'mooroon5', status: 'EPITA' },
].map((m) => ({ ...m, avatarUrl: '/brand/syncwave-mark-512.png' }));
---

<Layout
  title="Syncwave — le bracelet connecté des festivals"
  description="Syncwave réunit lumière, paiement sans contact, contrôle d'accès, localisation des amis et SOS dans un seul bracelet, avec une plateforme unique pour les organisateurs."
>
  <!-- Fond animé de toute la page, derrière tout le contenu. Reste --color-bg sans WebGL. -->
  <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
    <PageBackground client:only="react" />
  </div>

  <Header />

  <main id="contenu">
    <Hero />


    <!-- 2 à 5. Le récit : une nuit de festival, carte après carte — DESIGN.md §5 Récit -->
    <StoryStack
      id="fonctionnalites"
      title="Une nuit de festival avec Syncwave"
      intro="Suivez votre prochain festival côté organisation, de la préparation au bilan du lendemain. Neuf moments, un seul bracelet."
    >
      <StoryCard
        {...ch['le-constat']}
        statement="Un festival, cinq prestataires."
        text="Billetterie, paiement, sécurité, lumière, données : chaque brique a son contrat, sa facture et son outil. Le soir du festival, vos équipes jonglent entre cinq écrans."
      >
        <div class="story-chips" aria-label="Cinq prestataires remplacés par un bracelet Syncwave">
          {providers.map((p, k) => <span class="story-chip" style={`--k: ${k}`}>{p}</span>)}
          <span class="story-chip story-chip--one">1 bracelet Syncwave</span>
        </div>
      </StoryCard>

      <StoryCard
        {...ch['sous-le-silicone']}
        statement="Et si tout tenait dans un bracelet ?"
        text="Syncwave réunit billet, paiement, lumière et SOS dans un bracelet souple. Cinq pièces, aucun écran, rien à apprendre pour le public."
      >
        <ol slot="after" class="grid gap-1.5">
          {
            parts.map((part, i) => (
              <li class="flex items-baseline gap-3 text-small">
                <span class="w-6 shrink-0 font-display font-semibold text-cyan">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-text">{part}</span>
              </li>
            ))
          }
        </ol>
        <MediaCard caption="Vue éclatée du bracelet">
          <ExplodedView />
        </MediaCard>
      </StoryCard>

      <StoryCard
        {...ch['comment-ca-marche']}
        statement="Vous préparez. Le bracelet fait le reste."
        text="Chaque bracelet est associé à un billet et à un compte de paiement. Vous configurez l’événement sur une seule plateforme, pour toutes vos équipes."
      >
        <ul class="story-ticks grid gap-3 rounded-lg bg-surface-2 p-5">
          {
            preparation.map((item, k) => (
              <li class="flex items-start gap-3 text-body text-text" style={`--k: ${k}`}>
                <svg viewBox="0 0 24 24" fill="none" class="mt-0.5 size-6 shrink-0 stroke-cyan" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12.5 10 17.5 19 7" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </StoryCard>

      <StoryCard
        {...ch['ouverture']}
        statement="Le billet est déjà au poignet."
        text="À l’entrée, les festivaliers approchent le bracelet du lecteur : c’est validé. Pas de billet à chercher, rien à scanner, des files qui avancent."
        points={['Validation d’un geste', 'Rien à imprimer ni à scanner', 'Des entrées plus fluides']}
      >
        <div class="story-gate flex flex-col items-center gap-4 rounded-lg bg-surface-2 p-8">
          <svg viewBox="0 0 100 100" fill="none" class="size-32" aria-hidden="true">
            <circle cx="50" cy="50" r="45" class="stroke-line" stroke-width="4" />
            <circle cx="50" cy="50" r="45" class="story-gate__ring stroke-cyan" stroke-width="4" stroke-linecap="round" transform="rotate(-90 50 50)" />
            <path d="M32 51 45 64 69 38" class="stroke-cyan" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <p class="story-gate__label font-display text-h2 font-semibold text-text">Accès validé</p>
        </div>
      </StoryCard>

      <StoryCard
        {...ch['bars']}
        statement="Un geste, c’est payé."
        text="Aux bars et aux stands, le bracelet devient un moyen de paiement sans contact. Plus de monnaie, plus de carte à sortir, un service plus rapide."
        points={['Paiement sans contact', 'Plus de monnaie aux bars', 'Toutes les ventes centralisées']}
      >
        <MediaCard caption="Paiement sans contact">
          <PayMotion />
        </MediaCard>
      </StoryCard>

      <StoryCard
        {...ch['tete-d-affiche']}
        statement="La foule devient le show."
        text="Quand la tête d’affiche monte sur scène, la régie allume tous les bracelets en rythme. Chaque festivalier devient un point lumineux du spectacle, sans rien faire."
        points={['Piloté depuis la régie', 'Des effets qui traversent la foule', 'Aucune action du public']}
      >
        <MediaCard caption="Bandes LED synchronisées">
          <CrowdMotion />
        </MediaCard>
      </StoryCard>

      <StoryCard
        {...ch['alerte']}
        statement="Une alerte, une position, une équipe en route."
        text="Un festivalier appuie sur SOS : vos équipes de sécurité reçoivent l’alerte avec sa position exacte sur le site. Ses amis, eux, le retrouvent sur la carte."
        points={['Alerte en un geste', 'Position exacte transmise', 'Le groupe localisé sur la carte']}
      >
        <MediaCard caption="Alerte SOS sur le plan du festival">
          <SosMotion />
        </MediaCard>
      </StoryCard>

      <StoryCard
        {...ch['regie']}
        statement="Vous voyez tout, en direct."
        text="Entrées, ventes, affluence par zone, alertes : tout remonte sur un seul tableau de bord, en temps réel. Une IA vous aide à anticiper les pics."
        points={['Flux et affluence en direct', 'Les ventes de tous les stands', 'Des alertes géolocalisées']}
      >
        <!-- TODO: contenu à valider — préciser ce que fait réellement l'IA (prévision des flux ? détection d'incidents ?) -->
        <MediaCard caption="Tableau de bord organisateur (illustration)">
          <!-- TODO: visuel à produire — capture ou maquette réelle du tableau de bord organisateur -->
          <div class="flex aspect-4/3 flex-col justify-between bg-surface p-4" aria-hidden="true">
            <div class="flex gap-2 text-small text-text-muted">
              <span class="rounded-pill border border-line px-3 py-1 text-text">Flux</span>
              <span class="rounded-pill border border-line px-3 py-1">Ventes</span>
              <span class="rounded-pill border border-line px-3 py-1">Alertes</span>
            </div>
            <div class="story-bars flex h-2/3 items-end gap-2">
              {[40, 65, 50, 80, 95, 70, 85, 60].map((h, k) => <span class={`flex-1 rounded-sm ${k === 4 ? 'bg-cyan' : 'bg-line'}`} style={`height: ${h}%; --k: ${k}`} />)}
            </div>
          </div>
        </MediaCard>
      </StoryCard>

      <StoryCard
        {...ch['caracteristiques']}
        statement="Une seule facture."
        text="Un seul interlocuteur, un seul contrat, un prix fixe par festivalier. Et les données de toute la soirée pour préparer la prochaine édition."
      >
        <p class="mb-4 flex items-baseline gap-4 font-display text-h2 font-bold">
          <span class="story-invoice__old">5 factures</span>
          <span class="story-invoice__new text-text">1 facture</span>
        </p>
        <div class="grid gap-2">
          {specs.map((s) => <SpecCard value={s.value} label={s.label} highlight={s.highlight} />)}
        </div>
        <Button href="#demo" slot="after" class="mt-2 self-start">Demander une démo</Button>
      </StoryCard>
    </StoryStack>

    <div class="mx-auto flex max-w-card flex-col gap-4 px-3 py-section md:gap-6 md:px-4">
      <!-- 6. Demander une démo -->
      <SectionCard id="demo" title="Parlons de votre prochain événement">
        <Fold
          text="Dites-nous où et quand. Nous revenons vers vous avec une démonstration du bracelet et de la plateforme, adaptée à la taille de votre événement."
          class="text-body text-text-muted"
        />
        <Points items={['Le bracelet en main', 'Une visite de la plateforme organisateur', 'Une estimation pour votre festival']} />
        <div slot="aside"><DemoForm /></div>
      </SectionCard>
    </div>

    <!-- 7. L'équipe : cartes de profil — DESIGN.md §5 Équipe -->
    <section id="a-propos" class="mx-auto max-w-content px-6 pb-section md:px-12">
      <Fold as="h2" text="L’équipe Mooroon 5" class="text-h1 text-text" />
      <Fold
        text="Mooroon 5 est une équipe d’étudiants de l’EPITA. Syncwave est notre projet d’objet connecté : un bracelet pensé pour les festivals, les concerts et l’événementiel, du matériel à la plateforme."
        class="mt-6 text-body-lg text-text-muted"
      />
      <!-- TODO: contenu à valider — présentation de l'équipe, rôle de chacun, contexte du projet -->
      <ul class="team-list mt-12 flex flex-wrap justify-center gap-6">
        {team.map((m) => <li><TeamCard client:visible {...m} /></li>)}
      </ul>
      <p class="mt-12 text-small text-text-muted">Les visuels de ce site sont générés par IA à partir de la conception du bracelet.</p>
    </section>
  </main>

  <Footer />
</Layout>
